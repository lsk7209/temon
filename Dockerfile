FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS builder
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
ARG NEXT_PUBLIC_TEMON_STAGING=true
ENV NEXT_PUBLIC_TEMON_STAGING=$NEXT_PUBLIC_TEMON_STAGING
ARG NEXT_PUBLIC_APP_URL=https://temon.kr
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ARG NEXT_PUBLIC_CLARITY_ID
ARG NEXT_PUBLIC_ADSENSE_PUB_ID
ARG NEXT_PUBLIC_ADSENSE_CLIENT_ID
ARG NEXT_PUBLIC_ADSENSE_RESULT_SLOT_ID
ARG NEXT_PUBLIC_ADSENSE_DELIVERY_ENABLED
ARG NEXT_PUBLIC_ANALYTICS_CONSENT_MODE
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID NEXT_PUBLIC_CLARITY_ID=$NEXT_PUBLIC_CLARITY_ID NEXT_PUBLIC_ADSENSE_PUB_ID=$NEXT_PUBLIC_ADSENSE_PUB_ID NEXT_PUBLIC_ADSENSE_CLIENT_ID=$NEXT_PUBLIC_ADSENSE_CLIENT_ID NEXT_PUBLIC_ADSENSE_RESULT_SLOT_ID=$NEXT_PUBLIC_ADSENSE_RESULT_SLOT_ID NEXT_PUBLIC_ADSENSE_DELIVERY_ENABLED=$NEXT_PUBLIC_ADSENSE_DELIVERY_ENABLED NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=$NEXT_PUBLIC_ANALYTICS_CONSENT_MODE
RUN npm run build

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
