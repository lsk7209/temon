[Unit]
Description=Temon read-only Turso snapshot
Requires=docker.service
After=docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/temon-production
ExecStart=/usr/bin/flock -n /run/temon-backup.lock /usr/bin/bash /opt/temon-production/scripts/run-vps-backup.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true

