[Unit]
Description=Check Temon production container health
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/temon-production
ExecStart=/usr/bin/python3 /opt/temon-production/scripts/check-vps-health.py
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
